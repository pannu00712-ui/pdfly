{
  "name": "PDFly - Free PDF Tools",
  "short_name": "PDFly",
  "description": "Free online PDF tools — merge, split, compress, convert, edit, sign and more, right in your browser.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "theme_color": "#2563EB",
  "background_color": "#ffffff",
  "icons": [
    { "src": "/android-chrome-192.png?v=2", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/android-chrome-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/android-chrome-192.png?v=2", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/android-chrome-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/screenshots/home-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "PDFly homepage on desktop" },
    { "src": "/screenshots/home-narrow.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "PDFly homepage on mobile" }
  ],
  "prefer_related_applications": false,
  "categories": ["productivity", "utilities"],
  "lang": "en-US",
  "dir": "ltr",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/tools/pdf-reader?source=file_handler",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Merge PDF",
      "short_name": "Merge",
      "description": "Combine multiple PDFs into one file",
      "url": "/tools/merge-pdf?source=pwa",
      "icons": [{ "src": "/android-chrome-192.png?v=2", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Compress PDF",
      "short_name": "Compress",
      "description": "Reduce PDF file size",
      "url": "/tools/compress-pdf?source=pwa",
      "icons": [{ "src": "/android-chrome-192.png?v=2", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Split PDF",
      "short_name": "Split",
      "description": "Split a PDF into separate files",
      "url": "/tools/split-pdf?source=pwa",
      "icons": [{ "src": "/android-chrome-192.png?v=2", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
